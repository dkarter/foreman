[Desktop Entry]
Type=Application
Name=Foreman
Comment=Herdr agent control surface
Exec=chromium --ozone-platform=wayland --kiosk --noerrdialogs --disable-infobars --disable-session-crashed-bubble --disable-translate --overscroll-history-navigation=0 http://127.0.0.1:4041/choose
Icon=foreman
Terminal=false
X-GNOME-Autostart-enabled=true
