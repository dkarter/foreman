# @defaultRequired=true @defaultSensitive=false
# ---

# HTTP listen address for the host service.
# @type=string(minLength=2)
FOREMAN_ADDR=:4040

# Optional override for the Herdr server socket.
# @required=false
HERDR_SOCKET_PATH=

# Optional override for persisted Foreman settings.
# @required=false
FOREMAN_SETTINGS_PATH=

# Optional override for the host pairing trust store.
# @required=false
FOREMAN_PAIRING_PATH=

# Disable Bonjour advertisement in restricted network environments.
# @required=false @type=boolean
FOREMAN_DISABLE_DISCOVERY=false
